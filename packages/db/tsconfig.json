{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "types": ["node"],

    "declaration": true,
    "emitDeclarationOnly": false,

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },

  "include": ["src"]
}